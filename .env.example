# ------------------------------------------------------------------
# Dorisio — environment variables
# Copy to `.env` and fill in real values. Never commit real secrets.
# ------------------------------------------------------------------

# --- Database (required) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Application ---
# Public origin used for OAuth redirect URIs and PWA links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: force a specific site URL in production.
# SITE_URL=https://dorisio.app

# --- Session security ---
# 32+ random bytes, used to sign session cookies in future versions.
SESSION_SECRET=replace-with-a-long-random-string

# --- First admin bootstrap (trusted server-side) ---
# Set a one-time secret, call POST /api/admin/promote, then unset it.
ADMIN_SETUP_TOKEN=replace-with-a-one-time-setup-token

# --- OAuth: Google ---
# Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {APP_URL}/api/auth/oauth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OAuth: GitHub ---
# Settings → Developer settings → OAuth Apps
# Authorization callback URL: {APP_URL}/api/auth/oauth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- OAuth: Facebook ---
# https://developers.facebook.com/apps → Facebook Login → Settings
# Valid OAuth Redirect URI: {APP_URL}/api/auth/oauth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Password reset delivery (optional) ---
# When set, password reset links are also mailed; otherwise they are
# delivered as an in-app notification in «حسابي».
SMTP_URL=
MAIL_FROM=Dorisio <no-reply@dorisio.app>

# --- Web Push / FCM (optional) ---
# Standard VAPID keys for Web Push. With Firebase Cloud Messaging, use
# NEXT_PUBLIC_FIREBASE_* + FIREBASE_SERVER_KEY instead (see SETUP.md).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
FIREBASE_SERVER_KEY=

# --- Storage (optional) ---
# When set, uploaded images go to object storage instead of inline data URLs.
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=

# --- Development seed ---
# Must be set for POST /api/seed to create sample development data.
ALLOW_DEV_SEED=true
